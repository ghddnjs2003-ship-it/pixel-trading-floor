//@version=5
indicator("알티 더블 S + MDS 통합 지표", shorttitle="더블S+MDS", overlay=true, max_lines_count=500, max_labels_count=500, max_boxes_count=100)

// =============================================================================
// [0] 가격 스케일 동기화 (모바일/PC 스케일 분리 방지 필수 플롯)
// =============================================================================
plot(close, title="스케일 동기화", color=color.new(color.white, 100))

// =============================================================================
// [1] 사용자 입력 설정
// =============================================================================
grp_main = "🎯 기본 설정 (공식 체험판 UI)"
tradeDir = input.string("매수 or 매도", "매매 방향", options=["매수 or 매도", "매수", "매도"], group=grp_main)

grp_adv = "⚙️ 세부 설정 (선택 사항)"
pLen = input.int(10, "스윙 룩백 (피벗 좌우 봉수)", minval=3, maxval=50, group=grp_adv)
maxLvl = input.int(5, "최대 유지 레벨 수", minval=2, maxval=15, group=grp_adv)
useTrendFilter = input.bool(true, "폭락/폭등 추세 필터 (칼날잡기 방지)", group=grp_adv)
tblPosInput = input.string(position.bottom_right, "대시보드 위치", [position.top_left, position.top_right, position.bottom_left, position.bottom_right], group=grp_adv)

grp_switch = "🔀 지표 구성 (ON/OFF)"
useDoubleS = input.bool(true, "더블 S (BSL/SSL 스윕) 사용", group=grp_switch)
useMDS = input.bool(true, "MDS 단타 (매물대 박스 · M1 타점) 사용", group=grp_switch)

grp_box = "📦 MDS 매물대 박스"
showMDSBox = input.bool(true, "매물대 박스 표시", group=grp_box)
boxTF = input.timeframe("60", "박스 기준 상위 시간봉", group=grp_box)
boxPivLen = input.int(5, "박스 피벗 좌우 봉수 (상위TF)", minval=2, maxval=20, group=grp_box)
boxAtrMult = input.float(0.30, "박스 두께 (ATR 배수)", minval=0.05, maxval=1.0, step=0.05, group=grp_box)
boxPerSide = input.int(3, "방향별 최대 박스 수 (저항/지지)", minval=1, maxval=4, group=grp_box)
maxBoxBars = input.int(60, "박스 최대 유지 봉수 (초과 시 고정)", minval=10, maxval=300, step=5, group=grp_box)
boxExitBuf = input.float(0.10, "박스 이탈 판정 버퍼 (ATR)", minval=0.0, maxval=1.0, step=0.05, group=grp_box)
extendBars = input.int(80, "박스 종료 후 점선 연장 봉수", minval=0, maxval=300, step=10, group=grp_box)
showZoneLines = input.bool(true, "상단·중심(50%)·하단 점선 표시", group=grp_box)

grp_trend = "📈 대추세선"
showMajorTrend = input.bool(true, "대추세선 표시", group=grp_trend)
majorPivLen = input.int(48, "대추세선 스윙 룩백 (4시간봉 환산 권장 40~60)", minval=8, maxval=120, group=grp_trend)
majorMax = input.int(3, "방향별 최대 대추세선 수", minval=1, maxval=6, group=grp_trend)
trendExtendToNow = input.bool(true, "대추세선 현재 봉까지 연장", group=grp_trend)

grp_m1 = "🎯 M1 돌파 · 리테스트 타점"
useM1 = input.bool(true, "M1 타점 라벨 표시", group=grp_m1)
volMult = input.float(1.15, "돌파 거래량 배수 (평균 대비)", minval=1.0, maxval=3.0, step=0.05, group=grp_m1)
volLen = input.int(20, "거래량 평균 길이", minval=5, maxval=50, group=grp_m1)
retestBars = input.int(8, "리테스트 대기 최대 봉수", minval=1, maxval=30, group=grp_m1)
useM12 = input.bool(true, "M1-2 (손절 후 재돌파) 패턴 사용", group=grp_m1)
m12Bars = input.int(12, "재돌파 대기 최대 봉수", minval=2, maxval=50, group=grp_m1)
cooldownBars = input.int(15, "동일 신호 쿨타임 (봉수)", minval=0, maxval=100, group=grp_m1)
maxConsecSignals = input.int(2, "동일 방향 최대 연속 신호수", minval=1, maxval=5, group=grp_m1)

grp_retest = "🔁 리테스트 정밀도 (M1)"
useRetestVolDrop = input.bool(true, "리테스트 거래량 감소 필터", group=grp_retest)
retestVolAvgMult = input.float(1.10, "리테스트 거래량 평균 배수 상한", minval=1.0, maxval=2.0, step=0.05, group=grp_retest)

grp_htf = "🧭 상위 추세 동조"
useHtfTrend = input.bool(false, "상위 추세 동조 필터 (15분봉은 끄기 권장)", group=grp_htf)
htfTrendTF = input.timeframe("240", "상위 추세 시간봉", group=grp_htf)
htfEmaLen = input.int(50, "상위 추세 EMA 길이", minval=10, maxval=200, step=10, group=grp_htf)

grp_sweep = "🎯 스윕 깊이 필터 (더블 S)"
useSweepDepth = input.bool(true, "스윕 깊이 상·하한 필터 사용", group=grp_sweep)
minSweepAtr = input.float(0.05, "최소 스윕 깊이 (ATR 배수)", minval=0.0, maxval=0.5, step=0.01, group=grp_sweep)
maxSweepAtr = input.float(1.60, "최대 스윕 깊이 (ATR 배수)", minval=0.2, maxval=5.0, step=0.1, group=grp_sweep)

grp_filt = "🧪 내부 중첩 필터 (CCI + 볼린저밴드)"
useCCI = input.bool(true, "CCI 추세 강도 필터", group=grp_filt)
cciLen = input.int(20, "CCI 길이 (공식 스펙 20)", minval=10, maxval=40, group=grp_filt)
cciStrict = input.bool(false, "CCI ±100 기준 (엄격)", group=grp_filt)
useCciDiv = input.bool(true, "CCI 다이버전스 힌트 표시", group=grp_filt)
divLen = input.int(5, "다이버전스 피벗 좌우 봉수", minval=3, maxval=20, group=grp_filt)
useBB = input.bool(true, "볼린저밴드 확장 필터", group=grp_filt)
bbLen = input.int(20, "BB 길이", minval=5, maxval=50, group=grp_filt)
bbMult = input.float(2.0, "BB 표준편차", minval=1.0, maxval=4.0, step=0.1, group=grp_filt)
bbMode = input.string("평균 대비 확장", "확장 판정", options=["평균 대비 확장", "직전 봉 대비 확장"], group=grp_filt)
showBB = input.bool(false, "차트에 BB 선 표시", group=grp_filt)

allowLong = (tradeDir == "매수 or 매도" or tradeDir == "매수")
allowShort = (tradeDir == "매수 or 매도" or tradeDir == "매도")

// 스윕 꼬리 깊이 필터 (ATR 대비): 얕은 노이즈 스윕과 과도하게 깊은 이탈을 걸러냄
fSweepOk(float depth) =>
    not useSweepDepth or (depth >= minSweepAtr and depth <= maxSweepAtr)

// =============================================================================
// [2] 기본 지표 및 추세·안전장치 계산
// =============================================================================
atrVal = math.max(nz(ta.atr(14)), syminfo.mintick)

// 단기 추세 필터 (원웨이 폭락/폭등 시 역추세 가짜 스윕 방지)
ema20 = ta.ema(close, 20)
ema50 = ta.ema(close, 50)
isStrongDown = (close < ema20 and ema20 < ema50) or (close < open and close[1] < open[1] and close[2] < open[2])
isStrongUp = (close > ema20 and ema20 > ema50) or (close > open and close[1] > open[1] and close[2] > open[2])

ph = ta.pivothigh(high, pLen, pLen)
pl = ta.pivotlow(low, pLen, pLen)

candleRange = math.max(high - low, syminfo.mintick)
upperWick = high - math.max(open, close)
lowerWick = math.min(open, close) - low

// =============================================================================
// [3] 유동성 기준선 (BSL / SSL) 관리
// =============================================================================
type LvlLine
    line ln
    float p
    int startIdx
    bool isHigh
    bool swept
    bool consumed
    label lb

var bslLines = array.new<LvlLine>()
var sslLines = array.new<LvlLine>()

// BSL 고점 저항선 (빨간색 실선 + BSL 라벨)
if not na(ph) and useDoubleS
    line l = line.new(bar_index - pLen, ph, bar_index, ph, color=color.new(#ef5350, 10), width=1, style=line.style_solid)
    label lb = label.new(bar_index, ph, "BSL · " + str.tostring(ph, format.mintick), style=label.style_label_left, color=color.new(#1e222d, 100), textcolor=color.new(#ef5350, 0), size=size.small)
    array.push(bslLines, LvlLine.new(l, ph, bar_index - pLen, true, false, false, lb))
    if array.size(bslLines) > maxLvl
        LvlLine old = array.shift(bslLines)
        line.delete(old.ln)
        label.delete(old.lb)

// SSL 저점 지지선 (청록색 실선 + SSL 라벨)
if not na(pl) and useDoubleS
    line l = line.new(bar_index - pLen, pl, bar_index, pl, color=color.new(#00bcd4, 10), width=1, style=line.style_solid)
    label lb = label.new(bar_index, pl, "SSL · " + str.tostring(pl, format.mintick), style=label.style_label_left, color=color.new(#1e222d, 100), textcolor=color.new(#00bcd4, 0), size=size.small)
    array.push(sslLines, LvlLine.new(l, pl, bar_index - pLen, false, false, false, lb))
    if array.size(sslLines) > maxLvl
        LvlLine old = array.shift(sslLines)
        line.delete(old.ln)
        label.delete(old.lb)

// =============================================================================
// [4] 공식 2대 타점 판별: 거부(Rejection) vs 복귀(Reclaim)
// =============================================================================
bool shortRejection = false
bool shortReclaim = false
bool longRejection = false
bool longReclaim = false

// --- 숏 스윕 감시 (BSL) ---
if array.size(bslLines) > 0 and allowShort and useDoubleS
    for i = 0 to array.size(bslLines) - 1
        LvlLine item = array.get(bslLines, i)
        if not item.consumed
            // 활성선은 현재 봉까지 연장
            line.set_x2(item.ln, bar_index)
            label.set_x(item.lb, bar_index)

            // 패턴 1: 숏 거부 (Rejection) - 당일 봉 꼬리로 BSL 스윕 후 종가는 BSL 아래 음봉 복귀 마감
            float bslDepth = (high - item.p) / atrVal
            bool isSweep = high > item.p and fSweepOk(bslDepth)
            bool isReclaimedSameBar = close < item.p
            bool isBearishBar = close < open or (upperWick >= candleRange * 0.4 and close < high - candleRange * 0.3)
            bool passShortTrend = not useTrendFilter or not isStrongUp or (close < low[1] and close < open)

            if isSweep and isReclaimedSameBar and isBearishBar and passShortTrend and not item.swept
                item.swept := true
                item.consumed := true
                shortRejection := true

            // 패턴 2: 숏 복귀 (Pending Reclaim) - 직전 봉에서 BSL 위로 마감했다가 현재 봉에서 BSL 아래로 종가 복귀
            else if not item.consumed
                float bslPrevDepth = (high[1] - item.p) / atrVal
                bool prevAbove = high[1] > item.p and close[1] >= item.p and fSweepOk(bslPrevDepth)
                bool currBelow = close < item.p and close < open
                if prevAbove and currBelow and passShortTrend
                    item.swept := true
                    item.consumed := true
                    shortReclaim := true

            // 무효화 (상방으로 0.5 ATR 이상 완전 돌파 시 폐기)
            if not item.consumed and close > item.p + atrVal * 0.5 and close > open
                item.consumed := true

// --- 롱 스윕 감시 (SSL) ---
if array.size(sslLines) > 0 and allowLong and useDoubleS
    for i = 0 to array.size(sslLines) - 1
        LvlLine item = array.get(sslLines, i)
        if not item.consumed
            // 활성선은 현재 봉까지 연장
            line.set_x2(item.ln, bar_index)
            label.set_x(item.lb, bar_index)

            // 패턴 1: 롱 거부 (Rejection) - 당일 봉 꼬리로 SSL 스윕 후 종가는 SSL 위 양봉 복귀 마감
            float sslDepth = (item.p - low) / atrVal
            bool isSweep = low < item.p and fSweepOk(sslDepth)
            bool isReclaimedSameBar = close > item.p
            bool isBullishBar = close > open or (lowerWick >= candleRange * 0.4 and close > low + candleRange * 0.3)
            bool passLongTrend = not useTrendFilter or not isStrongDown or (close > high[1] and close > open)

            if isSweep and isReclaimedSameBar and isBullishBar and passLongTrend and not item.swept
                item.swept := true
                item.consumed := true
                longRejection := true

            // 패턴 2: 롱 복귀 (Pending Reclaim) - 직전 봉에서 SSL 아래 마감했다가 현재 봉에서 SSL 위로 종가 복귀
            else if not item.consumed
                float sslPrevDepth = (item.p - low[1]) / atrVal
                bool prevBelow = low[1] < item.p and close[1] <= item.p and fSweepOk(sslPrevDepth)
                bool currAbove = close > item.p and close > open
                if prevBelow and currAbove and passLongTrend
                    item.swept := true
                    item.consumed := true
                    longReclaim := true

            // 무효화 (하방으로 0.5 ATR 이상 완전 이탈 시 폐기)
            if not item.consumed and close < item.p - atrVal * 0.5 and close < open
                item.consumed := true

// =============================================================================
// [5] 공식 신호 라벨 출력 (영상과 100% 동일한 텍스트 및 스타일)
// =============================================================================
if shortRejection
    label.new(bar_index, high, "▼ 숏 · 거부", color=color.rgb(239, 83, 80), textcolor=color.white, style=label.style_label_down, size=size.small)
else if shortReclaim
    label.new(bar_index, high, "▼ 숏 · 복귀", color=color.rgb(239, 83, 80), textcolor=color.white, style=label.style_label_down, size=size.small)

if longRejection
    label.new(bar_index, low, "▲ 롱 · 거부", color=color.rgb(0, 188, 212), textcolor=color.white, style=label.style_label_up, size=size.small)
else if longReclaim
    label.new(bar_index, low, "▲ 롱 · 복귀", color=color.rgb(0, 188, 212), textcolor=color.white, style=label.style_label_up, size=size.small)

// =============================================================================
// [6] 가장 가까운 대기 레벨 탐색 (테이블 표시용)
// =============================================================================
float nearestBsl = na
float nearestSsl = na

if array.size(bslLines) > 0
    for i = 0 to array.size(bslLines) - 1
        LvlLine bItem = array.get(bslLines, i)
        if not bItem.consumed and bItem.p > close
            if na(nearestBsl) or bItem.p < nearestBsl
                nearestBsl := bItem.p

if array.size(sslLines) > 0
    for i = 0 to array.size(sslLines) - 1
        LvlLine sItem = array.get(sslLines, i)
        if not sItem.consumed and sItem.p < close
            if na(nearestSsl) or sItem.p > nearestSsl
                nearestSsl := sItem.p

// =============================================================================
// [7] 공식 3행 2열 대시보드 테이블 (초슬림 & 핵심 대기 레벨)
// =============================================================================
var table tbl = table.new(tblPosInput, 2, 4, bgcolor=color.new(#1e222d, 10), border_color=color.new(#374151, 60), border_width=1)

fPrice(float val) =>
    na(val) or val == 0.0 ? "-" : str.tostring(val, format.mintick)

if barstate.islast and useDoubleS
    // Header
    string tblTitle = "알티 더블 S 지표 · 차트 " + timeframe.period + " · " + tradeDir
    table.cell(tbl, 0, 0, tblTitle, bgcolor=color.new(#2a2e39, 0), text_color=color.white, text_size=size.small, text_halign=text.align_left)
    table.cell(tbl, 1, 0, "", bgcolor=color.new(#2a2e39, 0), text_size=size.small)

    // Row 1: 숏 대기 BSL
    table.cell(tbl, 0, 1, "숏 대기 BSL", bgcolor=color.new(#1e222d, 10), text_color=color.rgb(239, 83, 80), text_size=size.small, text_halign=text.align_center)
    table.cell(tbl, 1, 1, fPrice(nearestBsl), bgcolor=color.new(#1e222d, 10), text_color=color.white, text_size=size.small, text_halign=text.align_center)

    // Row 2: 롱 대기 SSL
    table.cell(tbl, 0, 2, "롱 대기 SSL", bgcolor=color.new(#1e222d, 10), text_color=color.rgb(0, 188, 212), text_size=size.small, text_halign=text.align_center)
    table.cell(tbl, 1, 2, fPrice(nearestSsl), bgcolor=color.new(#1e222d, 10), text_color=color.white, text_size=size.small, text_halign=text.align_center)

    // Row 3: 정식 버전 무제한 (공식 체험판 오렌지 배너 스타일 완벽 계승)
    table.cell(tbl, 0, 3, "정식 버전", bgcolor=color.rgb(245, 124, 0), text_color=color.white, text_size=size.small, text_halign=text.align_center)
    table.cell(tbl, 1, 3, "사용 기한 무제한 (영구)", bgcolor=color.rgb(245, 124, 0), text_color=color.white, text_size=size.small, text_halign=text.align_center)

// =============================================================================
// [8] MDS 내부 계산 (CCI · 볼린저밴드 · 거래량)
// =============================================================================
volSma = ta.sma(volume, volLen)
bool volOk = volume > volSma * volMult

// 공식 스펙: CCI 20 · hlc3 (M1 타점사례집 차트 설정과 동일)
float cciVal = ta.cci(hlc3, cciLen)
bool cciLongOk = cciStrict ? cciVal > 100 : cciVal > 0
bool cciShortOk = cciStrict ? cciVal < -100 : cciVal < 0

// CCI 다이버전스 (요약서 p.13): 가격 저점↓ + CCI 저점↑ = 상승 / 가격 고점↑ + CCI 고점↓ = 하락
float cciPvH = ta.pivothigh(cciVal, divLen, divLen)
float cciPvL = ta.pivotlow(cciVal, divLen, divLen)
var float prevCciPvH = na
var float prevPricePvH = na
var float prevCciPvL = na
var float prevPricePvL = na
var int lastBullDivBar = na
var int lastBearDivBar = na

if not na(cciPvH)
    float pvPriceH = high[divLen]
    if not na(prevCciPvH) and pvPriceH > prevPricePvH and cciPvH < prevCciPvH
        lastBearDivBar := bar_index
    prevCciPvH := cciPvH
    prevPricePvH := pvPriceH

if not na(cciPvL)
    float pvPriceL = low[divLen]
    if not na(prevCciPvL) and pvPriceL < prevPricePvL and cciPvL > prevCciPvL
        lastBullDivBar := bar_index
    prevCciPvL := cciPvL
    prevPricePvL := pvPriceL

int divValidBars = 30
bool bullDivActive = useCciDiv and not na(lastBullDivBar) and bar_index - lastBullDivBar <= divValidBars
bool bearDivActive = useCciDiv and not na(lastBearDivBar) and bar_index - lastBearDivBar <= divValidBars

float bbBasis = ta.sma(close, bbLen)
float bbDev = bbMult * ta.stdev(close, bbLen)
float bbUp = bbBasis + bbDev
float bbLo = bbBasis - bbDev
float bbWidth = bbBasis != 0 ? (bbUp - bbLo) / bbBasis * 100 : 0.0
float bbWidthAvg = ta.sma(bbWidth, 10)
bool bbExpand = bbMode == "직전 봉 대비 확장" ? bbWidth > bbWidth[1] : bbWidth > bbWidthAvg

bool filtLong = (not useCCI or cciLongOk) and (not useBB or bbExpand)
bool filtShort = (not useCCI or cciShortOk) and (not useBB or bbExpand)

// 상위 시간봉(4H 기본) 추세 동조 — M1 4조건 ① "상위 시간대 추세 같은 방향"
float htfTrendClose = request.security(syminfo.tickerid, htfTrendTF, close, lookahead=barmerge.lookahead_off)
float htfTrendEma = request.security(syminfo.tickerid, htfTrendTF, ta.ema(close, htfEmaLen), lookahead=barmerge.lookahead_off)
bool htfUp = not na(htfTrendClose) and not na(htfTrendEma) and htfTrendClose > htfTrendEma
bool htfDn = not na(htfTrendClose) and not na(htfTrendEma) and htfTrendClose < htfTrendEma

pBBUp = plot(showBB ? bbUp : na, title="BB 상단", color=color.new(#90caf9, 55), linewidth=1)
pBBLo = plot(showBB ? bbLo : na, title="BB 하단", color=color.new(#90caf9, 55), linewidth=1)
fill(pBBUp, pBBLo, color=color.new(#90caf9, 95), title="BB 영역")

// =============================================================================
// [8-B] 대추세선 (주요 스윙 고점·저점 연결 · 얇은 실선)
// =============================================================================
var array<line> dnTrend = array.new<line>()
var array<line> upTrend = array.new<line>()
var float lastMajPh = na
var float lastMajPl = na
var int lastMajPhBar = na
var int lastMajPlBar = na

color dnTrendCol = color.new(#ef5350, 40)
color upTrendCol = color.new(#26a69a, 40)

float majPh = ta.pivothigh(high, majorPivLen, majorPivLen)
float majPl = ta.pivotlow(low, majorPivLen, majorPivLen)

// 주요 고점이 낮아지면 하락 대추세선, 주요 저점이 높아지면 상승 대추세선
if showMajorTrend and not na(majPh)
    int pBar = bar_index - majorPivLen
    if not na(lastMajPh) and pBar > lastMajPhBar and majPh < lastMajPh
        line ln = line.new(lastMajPhBar, lastMajPh, pBar, majPh, color=dnTrendCol, width=1, style=line.style_solid)
        array.push(dnTrend, ln)
        while array.size(dnTrend) > majorMax
            line.delete(array.shift(dnTrend))
    lastMajPh := majPh
    lastMajPhBar := pBar

if showMajorTrend and not na(majPl)
    int pBar = bar_index - majorPivLen
    if not na(lastMajPl) and pBar > lastMajPlBar and majPl > lastMajPl
        line ln = line.new(lastMajPlBar, lastMajPl, pBar, majPl, color=upTrendCol, width=1, style=line.style_solid)
        array.push(upTrend, ln)
        while array.size(upTrend) > majorMax
            line.delete(array.shift(upTrend))
    lastMajPl := majPl
    lastMajPlBar := pBar

// 대추세선을 현재 봉까지 자연스럽게 연장
if showMajorTrend and trendExtendToNow
    if array.size(dnTrend) > 0
        for i = 0 to array.size(dnTrend) - 1
            line ln = array.get(dnTrend, i)
            int tx1 = line.get_x1(ln)
            int tx2 = line.get_x2(ln)
            if tx2 < bar_index and tx2 > tx1
                float ty1 = line.get_y1(ln)
                float ty2 = line.get_y2(ln)
                line.set_xy2(ln, bar_index, ty2 + (ty2 - ty1) / (tx2 - tx1) * (bar_index - tx2))
    if array.size(upTrend) > 0
        for i = 0 to array.size(upTrend) - 1
            line ln = array.get(upTrend, i)
            int tx1 = line.get_x1(ln)
            int tx2 = line.get_x2(ln)
            if tx2 < bar_index and tx2 > tx1
                float ty1 = line.get_y1(ln)
                float ty2 = line.get_y2(ln)
                line.set_xy2(ln, bar_index, ty2 + (ty2 - ty1) / (tx2 - tx1) * (bar_index - tx2))

// =============================================================================
// [9] MDS 매물대 박스 (상위 시간봉 피벗 · 몸통 기준)
// =============================================================================
type Zone
    box bx
    label lb
    float ztop
    float zbot
    float mid
    bool isRes
    int born
    bool frozen
    int frozenBar
    line lTop
    line lMid
    line lBot

var array<Zone> resZones = array.new<Zone>()
var array<Zone> supZones = array.new<Zone>()

int chartSec = timeframe.in_seconds()
int boxSec = timeframe.in_seconds(boxTF)
int barsPerBox = math.max(1, int(math.round(boxSec / math.max(chartSec, 1))))

float htfAtr = request.security(syminfo.tickerid, boxTF, ta.atr(14), lookahead=barmerge.lookahead_off)
float htfPh = request.security(syminfo.tickerid, boxTF, ta.pivothigh(math.max(open, close), boxPivLen, boxPivLen), lookahead=barmerge.lookahead_off)
float htfPl = request.security(syminfo.tickerid, boxTF, ta.pivotlow(math.min(open, close), boxPivLen, boxPivLen), lookahead=barmerge.lookahead_off)

float zoneW = nz(htfAtr, atrVal * 4.0) * boxAtrMult

color zoneColRes = color.new(#f5a623, 25)
color zoneFillRes = color.new(#f5a623, 88)
color zoneColSup = color.new(#42a5f5, 25)
color zoneFillSup = color.new(#42a5f5, 88)
color zoneColResOff = color.new(#f5a623, 100)
color zoneFillResOff = color.new(#f5a623, 100)
color zoneColSupOff = color.new(#42a5f5, 100)
color zoneFillSupOff = color.new(#42a5f5, 100)
color zoneLvlRes = color.new(#f5a623, 20)
color zoneLvlSup = color.new(#42a5f5, 20)
color zoneLvlMid = color.new(#b0bec5, 35)
color zoneColResForm = color.new(#f5a623, 55)
color zoneColSupForm = color.new(#42a5f5, 55)
color zoneFillResForm = color.new(#f5a623, 93)
color zoneFillSupForm = color.new(#42a5f5, 93)
color zoneColResSolid = color.new(#f5a623, 5)
color zoneColSupSolid = color.new(#42a5f5, 5)

// --- 저항 박스 생성 (상위TF 몸통 고점 피벗) ---
if useMDS and not na(htfPh) and (na(htfPh[1]) or htfPh != htfPh[1])
    float zt = htfPh + zoneW
    float zb = htfPh - zoneW
    bool merged = false
    if array.size(resZones) > 0
        for i = 0 to array.size(resZones) - 1
            Zone z = array.get(resZones, i)
            if not merged and math.abs(z.mid - htfPh) <= zoneW * 1.5
                merged := true
    if not merged
        int zx = math.max(0, bar_index - boxPivLen * barsPerBox)
        // 형성 중 = 점선 테두리 (AM 공식: 점선은 아직 만들어지는 중 · 관망)
        box bx = box.new(zx, zt, bar_index, zb, border_color=showMDSBox ? zoneColResForm : zoneColResOff, bgcolor=showMDSBox ? zoneFillResForm : zoneFillResOff, border_width=1, border_style=line.style_dashed)
        label lb = na
        array.push(resZones, Zone.new(bx, lb, zt, zb, (zt + zb) / 2, true, bar_index, false, na, na, na, na))
    while array.size(resZones) > boxPerSide
        int wi = 0
        float wd = -1.0
        for i = 0 to array.size(resZones) - 1
            Zone zz = array.get(resZones, i)
            float d = math.abs(zz.mid - close)
            if d > wd
                wd := d
                wi := i
        Zone wz = array.get(resZones, wi)
        box.delete(wz.bx)
        if not na(wz.lb)
            label.delete(wz.lb)
        if not na(wz.lTop)
            line.delete(wz.lTop)
            line.delete(wz.lMid)
            line.delete(wz.lBot)
        array.remove(resZones, wi)

// --- 지지 박스 생성 (상위TF 몸통 저점 피벗) ---
if useMDS and not na(htfPl) and (na(htfPl[1]) or htfPl != htfPl[1])
    float zt = htfPl + zoneW
    float zb = htfPl - zoneW
    bool merged = false
    if array.size(supZones) > 0
        for i = 0 to array.size(supZones) - 1
            Zone z = array.get(supZones, i)
            if not merged and math.abs(z.mid - htfPl) <= zoneW * 1.5
                merged := true
    if not merged
        int zx = math.max(0, bar_index - boxPivLen * barsPerBox)
        // 형성 중 = 점선 테두리 (AM 공식: 점선은 아직 만들어지는 중 · 관망)
        box bx = box.new(zx, zt, bar_index, zb, border_color=showMDSBox ? zoneColSupForm : zoneColSupOff, bgcolor=showMDSBox ? zoneFillSupForm : zoneFillSupOff, border_width=1, border_style=line.style_dashed)
        label lb = na
        array.push(supZones, Zone.new(bx, lb, zt, zb, (zt + zb) / 2, false, bar_index, false, na, na, na, na))
    while array.size(supZones) > boxPerSide
        int wi = 0
        float wd = -1.0
        for i = 0 to array.size(supZones) - 1
            Zone zz = array.get(supZones, i)
            float d = math.abs(zz.mid - close)
            if d > wd
                wd := d
                wi := i
        Zone wz = array.get(supZones, wi)
        box.delete(wz.bx)
        if not na(wz.lb)
            label.delete(wz.lb)
        if not na(wz.lTop)
            line.delete(wz.lTop)
            line.delete(wz.lMid)
            line.delete(wz.lBot)
        array.remove(supZones, wi)

// --- 존 상태 관리: 유지 중엔 박스만 연장, 이탈·만료 시 박스 고정 + 상/중심/하단 점선 연장 ---
if useMDS and array.size(resZones) > 0
    for i = 0 to array.size(resZones) - 1
        Zone z = array.get(resZones, i)
        if not z.frozen
            bool brokeOut = close > z.ztop + atrVal * boxExitBuf or close < z.zbot - atrVal * boxExitBuf
            // 형성 중(점선)을 최소 4봉 유지한 뒤 확정 → 점선/실선 구분이 실제로 보이도록
            if (brokeOut and bar_index - z.born >= 4) or bar_index - z.born >= maxBoxBars
                z.frozen := true
                z.frozenBar := bar_index
                // 확정 매물대 → 실선 테두리로 전환 (M1 판단 기준선)
                if showMDSBox
                    box.set_border_style(z.bx, line.style_solid)
                    box.set_border_color(z.bx, zoneColResSolid)
                    box.set_bgcolor(z.bx, zoneFillRes)
                if showMDSBox and showZoneLines
                    z.lTop := line.new(bar_index, z.ztop, bar_index, z.ztop, color=zoneLvlRes, style=line.style_dotted, width=1)
                    z.lMid := line.new(bar_index, z.mid, bar_index, z.mid, color=zoneLvlMid, style=line.style_dotted, width=1)
                    z.lBot := line.new(bar_index, z.zbot, bar_index, z.zbot, color=zoneLvlRes, style=line.style_dotted, width=1)
            else
                box.set_right(z.bx, bar_index)
        if z.frozen and showMDSBox and showZoneLines and not na(z.lTop)
            int extTo = math.min(z.frozenBar + extendBars, bar_index)
            line.set_x2(z.lTop, extTo)
            line.set_x2(z.lMid, extTo)
            line.set_x2(z.lBot, extTo)

if useMDS and array.size(supZones) > 0
    for i = 0 to array.size(supZones) - 1
        Zone z = array.get(supZones, i)
        if not z.frozen
            bool brokeOut = close > z.ztop + atrVal * boxExitBuf or close < z.zbot - atrVal * boxExitBuf
            // 형성 중(점선)을 최소 4봉 유지한 뒤 확정 → 점선/실선 구분이 실제로 보이도록
            if (brokeOut and bar_index - z.born >= 4) or bar_index - z.born >= maxBoxBars
                z.frozen := true
                z.frozenBar := bar_index
                // 확정 매물대 → 실선 테두리로 전환 (M1 판단 기준선)
                if showMDSBox
                    box.set_border_style(z.bx, line.style_solid)
                    box.set_border_color(z.bx, zoneColSupSolid)
                    box.set_bgcolor(z.bx, zoneFillSup)
                if showMDSBox and showZoneLines
                    z.lTop := line.new(bar_index, z.ztop, bar_index, z.ztop, color=zoneLvlSup, style=line.style_dotted, width=1)
                    z.lMid := line.new(bar_index, z.mid, bar_index, z.mid, color=zoneLvlMid, style=line.style_dotted, width=1)
                    z.lBot := line.new(bar_index, z.zbot, bar_index, z.zbot, color=zoneLvlSup, style=line.style_dotted, width=1)
            else
                box.set_right(z.bx, bar_index)
        if z.frozen and showMDSBox and showZoneLines and not na(z.lTop)
            int extTo = math.min(z.frozenBar + extendBars, bar_index)
            line.set_x2(z.lTop, extTo)
            line.set_x2(z.lMid, extTo)
            line.set_x2(z.lBot, extTo)

// =============================================================================
// [10] M1 / M1-2 타점 (거래량 실린 종가 돌파 → 첫 리테스트)
// =============================================================================
var bool upArmed = false
var int upArmBar = na
var float upLvl = na
var float upBotLvl = na
var float upBreakoutVol = na
var bool upM12Mode = false
var bool upStopped = false
var int upStopBar = na

var bool dnArmed = false
var int dnArmBar = na
var float dnLvl = na
var float dnTopLvl = na
var float dnBreakoutVol = na
var bool dnM12Mode = false
var bool dnStopped = false
var int dnStopBar = na

var int lastLongBar = na
var int lastShortBar = na
var float m1Stop = na
var float m1Target = na
var int m1Dir = 0
var int m1SignalBar = na

// 돌파 감지 (저항 박스 상단 돌파)
bool armUpHit = false
float armUpTop = na
float armUpBot = na
float armUpVol = na
if useMDS and useM1 and array.size(resZones) > 0
    for i = 0 to array.size(resZones) - 1
        Zone z = array.get(resZones, i)
        if close[1] <= z.ztop and close > z.ztop and volOk
            if na(armUpTop) or z.ztop < armUpTop
                armUpTop := z.ztop
                armUpBot := z.zbot
                armUpVol := volume
                armUpHit := true

// 돌파 감지 (지지 박스 하단 이탈)
bool armDnHit = false
float armDnBot = na
float armDnTop = na
float armDnVol = na
if useMDS and useM1 and array.size(supZones) > 0
    for i = 0 to array.size(supZones) - 1
        Zone z = array.get(supZones, i)
        if close[1] >= z.zbot and close < z.zbot and volOk
            if na(armDnBot) or z.zbot > armDnBot
                armDnBot := z.zbot
                armDnTop := z.ztop
                armDnVol := volume
                armDnHit := true

if useMDS and useM1 and armUpHit
    upArmed := true
    upArmBar := bar_index
    upLvl := armUpTop
    upBotLvl := armUpBot
    upBreakoutVol := armUpVol
    upM12Mode := false
    upStopped := false

if useMDS and useM1 and armDnHit
    dnArmed := true
    dnArmBar := bar_index
    dnLvl := armDnBot
    dnTopLvl := armDnTop
    dnBreakoutVol := armDnVol
    dnM12Mode := false
    dnStopped := false

// 리테스트 판정
bool sigLong = false
bool sigLongM12 = false
bool sigShort = false
bool sigShortM12 = false

if useMDS and useM1 and upArmed and bar_index > upArmBar
    int age = bar_index - upArmBar
    bool touch = low <= upLvl + atrVal * 0.15
    bool holds = close > upLvl
    bool bull = close > open
    // 첫 리테스트는 거래량이 줄어든 상태에서 막히는 것이 공식 체크 포인트
    bool retestVolDrop = not useRetestVolDrop or na(upBreakoutVol) or volume < upBreakoutVol or volume <= volSma * retestVolAvgMult
    bool htfOkLong = not useHtfTrend or htfUp
    if age <= retestBars and touch and holds and bull and filtLong and allowLong and retestVolDrop and htfOkLong
        if upM12Mode
            sigLongM12 := true
        else
            sigLong := true
        upArmed := false
    else if close < upBotLvl
        upArmed := false
        if useM12
            upStopped := true
            upStopBar := bar_index
    else if age > retestBars
        upArmed := false

if useMDS and useM1 and dnArmed and bar_index > dnArmBar
    int age = bar_index - dnArmBar
    bool touch = high >= dnLvl - atrVal * 0.15
    bool holds = close < dnLvl
    bool bear = close < open
    // 첫 리테스트는 거래량이 줄어든 상태에서 막히는 것이 공식 체크 포인트
    bool retestVolDrop = not useRetestVolDrop or na(dnBreakoutVol) or volume < dnBreakoutVol or volume <= volSma * retestVolAvgMult
    bool htfOkShort = not useHtfTrend or htfDn
    if age <= retestBars and touch and holds and bear and filtShort and allowShort and retestVolDrop and htfOkShort
        if dnM12Mode
            sigShortM12 := true
        else
            sigShort := true
        dnArmed := false
    else if close > dnTopLvl
        dnArmed := false
        if useM12
            dnStopped := true
            dnStopBar := bar_index
    else if age > retestBars
        dnArmed := false

// M1-2: 손절(박스 재진입) 후 같은 경계 재돌파
if useMDS and useM1 and useM12 and upStopped and not upArmed
    if bar_index - upStopBar > m12Bars
        upStopped := false
    else if close > upLvl and close[1] <= upLvl and volOk
        upStopped := false
        upArmed := true
        upArmBar := bar_index
        upM12Mode := true

if useMDS and useM1 and useM12 and dnStopped and not dnArmed
    if bar_index - dnStopBar > m12Bars
        dnStopped := false
    else if close < dnLvl and close[1] >= dnLvl and volOk
        dnStopped := false
        dnArmed := true
        dnArmBar := bar_index
        dnM12Mode := true

// 타점 라벨 (더블 S와 색감·문구 구분) + 동일 신호 쿨타임 · 연속 신호 제한
var int lastM1SignalBar = na
var int consecLongSig = 0
var int consecShortSig = 0

// 쿨타임의 3배 이상 조용했다면 연속 카운트를 새로 시작
if not na(lastM1SignalBar) and bar_index - lastM1SignalBar > cooldownBars * 3
    consecLongSig := 0
    consecShortSig := 0

bool coolOk = na(lastM1SignalBar) or bar_index - lastM1SignalBar >= cooldownBars
bool longLabelOk = coolOk and consecLongSig < maxConsecSignals
bool shortLabelOk = coolOk and consecShortSig < maxConsecSignals

if (sigLong or sigLongM12) and longLabelOk
    label.new(bar_index, low, sigLong ? "▲ M1 롱 · CCI+BB" : "▲ M1-2 롱 · CCI+BB", color=sigLong ? color.rgb(0, 200, 83) : color.rgb(0, 150, 136), textcolor=color.white, style=label.style_label_up, size=size.small)
    lastLongBar := bar_index
    consecLongSig += 1
    consecShortSig := 0
    lastM1SignalBar := bar_index
    // 손절 = 진입 기준 박스 내부 재진입 / 목표 = 다음 반대 매물대 (요약서 p.10~11)
    m1Stop := upBotLvl
    float tgtL = na
    if array.size(resZones) > 0
        for j = 0 to array.size(resZones) - 1
            Zone zc = array.get(resZones, j)
            if zc.zbot > upLvl
                if na(tgtL)
                    tgtL := zc.zbot
                else if zc.zbot < tgtL
                    tgtL := zc.zbot
    m1Target := tgtL
    m1Dir := 1
    m1SignalBar := bar_index

if (sigShort or sigShortM12) and shortLabelOk
    label.new(bar_index, high, sigShort ? "▼ M1 숏 · CCI+BB" : "▼ M1-2 숏 · CCI+BB", color=sigShort ? color.rgb(255, 112, 67) : color.rgb(244, 81, 30), textcolor=color.white, style=label.style_label_down, size=size.small)
    lastShortBar := bar_index
    consecShortSig += 1
    consecLongSig := 0
    lastM1SignalBar := bar_index
    // 손절 = 진입 기준 박스 내부 재진입 / 목표 = 다음 반대 매물대 (요약서 p.10~11)
    m1Stop := dnTopLvl
    float tgtS = na
    if array.size(supZones) > 0
        for j = 0 to array.size(supZones) - 1
            Zone zc = array.get(supZones, j)
            if zc.ztop < dnLvl
                if na(tgtS)
                    tgtS := zc.ztop
                else if zc.ztop > tgtS
                    tgtS := zc.ztop
    m1Target := tgtS
    m1Dir := -1
    m1SignalBar := bar_index

// =============================================================================
// [11] 우상단 MDS 요약 대시보드
// =============================================================================
float nearResTop = na
float nearSupBot = na
bool insideBox = false

if useMDS and array.size(resZones) > 0
    for i = 0 to array.size(resZones) - 1
        Zone z = array.get(resZones, i)
        if close >= z.zbot and close <= z.ztop
            insideBox := true
        if z.zbot > close
            if na(nearResTop) or z.zbot < nearResTop
                nearResTop := z.zbot

if useMDS and array.size(supZones) > 0
    for i = 0 to array.size(supZones) - 1
        Zone z = array.get(supZones, i)
        if close >= z.zbot and close <= z.ztop
            insideBox := true
        if z.ztop < close
            if na(nearSupBot) or z.ztop > nearSupBot
                nearSupBot := z.ztop

string mdsStatus = "박스 내부 (관망)"
if not useMDS
    mdsStatus := "MDS 꺼짐"
else if not na(lastLongBar) and bar_index - lastLongBar <= retestBars
    mdsStatus := "M1 롱 조건 충족"
else if not na(lastShortBar) and bar_index - lastShortBar <= retestBars
    mdsStatus := "M1 숏 조건 충족"
else if upArmed
    mdsStatus := "상방 돌파 (리테스트 대기)"
else if dnArmed
    mdsStatus := "하방 돌파 (리테스트 대기)"
else if insideBox
    mdsStatus := "박스 내부 (관망)"
else if not na(nearResTop) and close > nearResTop
    mdsStatus := "박스 상단 돌파 (추격 금지)"
else if not na(nearSupBot) and close < nearSupBot
    mdsStatus := "박스 하단 이탈 (추격 금지)"
else
    mdsStatus := "박스 사이 (관망)"

color mdsStatusCol = str.contains(mdsStatus, "충족") ? color.rgb(0, 230, 118) : color.white

fTfLabel(string tf) =>
    tf == "1" ? "1m" : tf == "3" ? "3m" : tf == "5" ? "5m" : tf == "15" ? "15m" : tf == "30" ? "30m" : tf == "60" ? "1H" : tf == "120" ? "2H" : tf == "240" ? "4H" : tf == "D" ? "1D" : tf

string divText = "꺼짐"
if useCciDiv
    divText := bullDivActive and bearDivActive ? "혼조 (상·하락)" : bullDivActive ? "상승 · 롱 신뢰↑" : bearDivActive ? "하락 · 숏 신뢰↑" : "없음"

string htfText = useHtfTrend ? (htfUp ? "상승 동조" : htfDn ? "하락 동조" : "혼조 · 관망") : "필터 꺼짐"

string rrText = "M1 대기"
string rrLabel = "손절 / 목표"
if not na(m1SignalBar) and bar_index - m1SignalBar <= math.max(retestBars * 3, 20)
    rrText := fPrice(m1Stop) + " / " + fPrice(m1Target)
    rrLabel := m1Dir == 1 ? "손절 / 목표 (롱)" : m1Dir == -1 ? "손절 / 목표 (숏)" : "손절 / 목표"

var table mdsTbl = table.new(position.top_right, 2, 6, bgcolor=color.new(#131722, 5), border_color=color.new(#2962ff, 70), border_width=1)

if barstate.islast and useMDS
    string tfLabel = fTfLabel(boxTF)
    table.cell(mdsTbl, 0, 0, "MDS · " + tfLabel + " 박스 실선=확정·점선=형성", bgcolor=color.new(#1a2035, 0), text_color=color.rgb(144, 202, 249), text_size=size.small, text_halign=text.align_left)
    table.cell(mdsTbl, 1, 0, "", bgcolor=color.new(#1a2035, 0), text_size=size.small)
    table.cell(mdsTbl, 0, 1, "현재 상태", bgcolor=color.new(#131722, 5), text_color=color.rgb(176, 190, 197), text_size=size.small, text_halign=text.align_center)
    table.cell(mdsTbl, 1, 1, mdsStatus, bgcolor=color.new(#131722, 5), text_color=mdsStatusCol, text_size=size.small, text_halign=text.align_center)
    table.cell(mdsTbl, 0, 2, "CCI(20) / BB", bgcolor=color.new(#131722, 5), text_color=color.rgb(176, 190, 197), text_size=size.small, text_halign=text.align_center)
    table.cell(mdsTbl, 1, 2, str.tostring(cciVal, "#.#") + " / " + (bbExpand ? "확장" : "수축"), bgcolor=color.new(#131722, 5), text_color=bbExpand ? color.rgb(255, 213, 79) : color.rgb(144, 202, 249), text_size=size.small, text_halign=text.align_center)
    table.cell(mdsTbl, 0, 3, "다이버전스", bgcolor=color.new(#131722, 5), text_color=color.rgb(176, 190, 197), text_size=size.small, text_halign=text.align_center)
    table.cell(mdsTbl, 1, 3, divText, bgcolor=color.new(#131722, 5), text_color=(bullDivActive or bearDivActive) ? color.rgb(0, 230, 118) : color.rgb(144, 164, 174), text_size=size.small, text_halign=text.align_center)
    table.cell(mdsTbl, 0, 4, "상위 " + fTfLabel(htfTrendTF) + " 추세", bgcolor=color.new(#131722, 5), text_color=color.rgb(176, 190, 197), text_size=size.small, text_halign=text.align_center)
    table.cell(mdsTbl, 1, 4, htfText, bgcolor=color.new(#131722, 5), text_color=useHtfTrend ? color.rgb(255, 213, 79) : color.rgb(144, 164, 174), text_size=size.small, text_halign=text.align_center)
    table.cell(mdsTbl, 0, 5, rrLabel, bgcolor=color.new(#131722, 5), text_color=color.rgb(176, 190, 197), text_size=size.small, text_halign=text.align_center)
    table.cell(mdsTbl, 1, 5, rrText, bgcolor=color.new(#131722, 5), text_color=rrText == "M1 대기" ? color.rgb(144, 164, 174) : color.rgb(255, 255, 255), text_size=size.small, text_halign=text.align_center)

// =============================================================================
// [12] 매물대 라벨 최소화 (방향별 가장 가까운 존 1개만 · 겹침 제거)
// =============================================================================
var label resTag = na
var label supTag = na

if barstate.islast and useMDS and showMDSBox
    if not na(resTag)
        label.delete(resTag)
        resTag := na
    if not na(supTag)
        label.delete(supTag)
        supTag := na

    Zone nRes = na
    Zone nSup = na
    if array.size(resZones) > 0
        for i = 0 to array.size(resZones) - 1
            Zone z = array.get(resZones, i)
            if z.zbot > close
                if na(nRes)
                    nRes := z
                else if z.zbot < nRes.zbot
                    nRes := z
    if array.size(supZones) > 0
        for i = 0 to array.size(supZones) - 1
            Zone z = array.get(supZones, i)
            if z.ztop < close
                if na(nSup)
                    nSup := z
                else if z.ztop > nSup.ztop
                    nSup := z

    if not na(nRes)
        int xr = box.get_right(nRes.bx)
        resTag := label.new(xr, nRes.ztop, "저항 " + fPrice(nRes.zbot) + "~" + fPrice(nRes.ztop) + (nRes.frozen ? " · 확정" : " · 형성"), style=label.style_label_left, color=color.new(#1e222d, 25), textcolor=color.new(#f5a623, 0), size=size.tiny)
    if not na(nSup)
        int xs = box.get_right(nSup.bx)
        supTag := label.new(xs, nSup.zbot, "지지 " + fPrice(nSup.zbot) + "~" + fPrice(nSup.ztop) + (nSup.frozen ? " · 확정" : " · 형성"), style=label.style_label_left, color=color.new(#1e222d, 25), textcolor=color.new(#42a5f5, 0), size=size.tiny)
