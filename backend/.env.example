# backend/.env 로 복사한 뒤, 아래 중 '하나'만 채우면 바로 돌아갑니다.
# (무료 키 발급: Groq console.groq.com · Gemini aistudio.google.com · Cerebras cloud.cerebras.ai ·
#  OpenRouter openrouter.ai/keys)  Ollama는 키가 필요 없습니다.
LLM_PROVIDER=auto

# --- 무료 한도 제공자 (먼저 검증할 곳) ---
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

GEMINI_API_KEY=
# 2026-11 실측: gemini-2.0-flash는 신규 사용자에게 404(폐기) · gemini-3.7/3.8-flash는 응답 지연·503
# GEMINI_MODEL=gemini-3.5-flash-lite

CEREBRAS_API_KEY=
# CEREBRAS_MODEL=llama-3.3-70b

OPENROUTER_API_KEY=
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# --- 로컬 (RTX 3060 Ti · Ollama) ---
# LLM_PROVIDER=ollama
# OLLAMA_MODEL=qwen2.5:7b-instruct

# --- 유료 (지금은 쓰지 않음) ---
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini
XAI_API_KEY=
# XAI_MODEL=grok-3-mini

# 공통 덮어쓰기 (새 모델·자체 서버 대응)
# LLM_BASE_URL=
# LLM_MODEL=

# v7 룰 엔진 (비우면 파인스크립트 기본값)
# V7_MIN_RR=1.5
# V7_VOLUME_MULT=1.15
# V7_CCI_MODE=sign

# 킬스위치
# KILL_DAILY_LOSS_PCT=3
# KILL_MAX_CONSECUTIVE_LOSSES=3
# KILL_MAX_DAILY_TRADES=20
# KILL_VOLATILITY_ATR_PCT=2.5
# KILL_COOLDOWN_MINUTES=30

PORT=8765

# --- AI 맥락 필터 (v7 M1 후보 → Gemini PASS/REJECT) ---
# auto: 제공자 키가 있으면 켜고, 없으면 끈다.  off: 13인 분석만 쓴다.
# AI_FILTER=auto
# AI_FILTER_MODEL=            # 비우면 GEMINI_MODEL
# AI_FILTER_MIN_INTERVAL=2.0  # 호출 사이 최소 간격(초) — 무료 한도의 분당 한도 보호
# AI_FILTER_MAX_CALLS=0       # 실행 1회 최대 호출 수(0 = 제한 없음, 초과분은 '통과'로 남긴다)
# AI_FILTER_ON_ERROR=pass     # pass | reject — AI 장애 시 처리
# AI_FILTER_VETO=on           # on이면 REJECT가 13인 분석의 진입을 HOLD로 내린다
# AI_FILTER_THRESHOLD=60      # (참고) loss_prob 문턱 — 실행 인자 --threshold와 같은 값
